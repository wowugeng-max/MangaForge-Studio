{
  "name": "mangaforge-studio-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:server": "cd ui/server && bun run dev",
    "dev:web": "cd ui/web && bun run dev",
    "build:server": "cd ui/server && bun run build",
    "build:web": "cd ui/web && bun run build",
    "check": "bun run check:refactor-boundaries && bun run build:server && bun run build:web",
    "check:oh-story-progress": "node scripts/check-oh-story-adoption-progress.mjs",
    "check:refactor-boundaries": "node scripts/check-refactor-boundaries.mjs",
    "smoke:novel": "node scripts/check-novel-generation-workflow.mjs",
    "smoke:novel:local": "node scripts/run-novel-smoke-local.mjs",
    "test:novel-server": "cd ui/server && bun test src/novel.test.ts src/routes/novel-core-routes.test.ts src/routes/novel-writing-service.quality-wiring.test.ts src/routes/novel-writing-service.test.ts src/routes/novel-editor-routes.test.ts src/routes/novel-generation-routes.test.ts src/routes/novel-planning-routes.test.ts src/routes/novel-setting-routes.test.ts src/routes/novel-production-service.behavior.test.ts src/routes/novel-unattended-goal.integration.test.ts src/routes/novel-original-incubator-service.test.ts",
    "test:novel-entry": "cd ui/web && bun test src/components/novel-entry/launchpadModel.test.ts src/components/novel-entry/deepDraftReviewModel.test.ts src/pages/novel-lobby/novelLobbyModel.test.ts",
    "test:planning-workspace": "cd ui/web && bun test src/pages/novel-workspace/planningWorkspaceModel.test.ts",
    "test:writing-cockpit": "cd ui/web && bun test src/pages/novel-workspace/writingCockpitModel.test.ts src/pages/novel-workspace/writingRecommendationModel.test.ts src/pages/novel-workspace/autoCreationDirectorModel.test.ts src/pages/novel-workspace/repairTaskRevisionPrompt.test.ts src/pages/novel-workspace/TaskCenterDrawer.test.ts src/pages/novel-workspace/workspaceUiShell.test.ts src/pages/novel-workspace/writingBibleDefaults.test.ts src/pages/novel-workspace/outlineTreeModel.test.ts",
    "validate:novel-prose-quality": "bun scripts/validate-novel-prose-quality-recovery.ts"
  }
}
